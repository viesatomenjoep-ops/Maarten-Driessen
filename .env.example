# ============================================================
#  Maarten Driessen Sporthorses — environment template
#  Kopieer naar `.env` en vul in.   cp .env.example .env
# ============================================================

# ---- Lokale Postgres (Docker compose) ----------------------
POSTGRES_USER=md
POSTGRES_PASSWORD=md_secret_change_me
POSTGRES_DB=md_horses
DATABASE_URL=postgres://md:md_secret_change_me@localhost:5432/md_horses

# ---- PgAdmin ----------------------------------------------
PGADMIN_EMAIL=admin@maartendriessen.be
PGADMIN_PASSWORD=md_secret_change_me

# ---- Supabase (managed) -----------------------------------
# Te vinden in:  Supabase project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...replace_me...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...keep_secret...   # NIET in frontend gebruiken

# ---- Cloudinary -------------------------------------------
# Te vinden in:  Cloudinary dashboard → Account details
CLOUDINARY_CLOUD_NAME=maartendriessen
CLOUDINARY_UPLOAD_PRESET=md_horses                       # Settings → Upload → Add upload preset (Unsigned)
CLOUDINARY_API_KEY=your_api_key                          # alleen nodig voor server-side / admin-API
CLOUDINARY_API_SECRET=your_api_secret                    # NIET in frontend gebruiken
CLOUDINARY_FOLDER=horses

# ---- Vertaling (optioneel, voor admin) --------------------
DEEPL_API_KEY=

# ---- Mail (optioneel — voor notificaties) -----------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mail.maartendriessen.be
